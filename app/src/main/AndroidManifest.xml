<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ImmichPickerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ImmichPicker">

        <!--
            Settings screen and launcher entry point.

            The LAUNCHER filter lives here, directly on the activity. An activity-alias was
            tried so the icon could be toggled at runtime, but Android 10+ does not honour
            component disabling reliably: launchers keep a persisted entry that survives
            reboots and falls back to App Info when tapped. Hiding the icon is therefore not
            something a shipped APK can promise, so the feature was removed rather than
            shipped half-working. Use a separate build without the filter if a drawer-less
            APK is ever needed.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ImmichPicker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Discoverability bridge for pickers that list apps instead of SAF roots.

            There are two chooser implementations on modern Android. DocumentsUI lists
            provider *roots*, so the root below is enough for both GET_CONTENT and
            OPEN_DOCUMENT. The system photo picker, however, lists *apps that answer the
            intent* and shows no roots at all — so a provider-only app is invisible in it,
            which is where media uploads from browsers such as Firefox land.

            This activity has no UI of its own. It exists so those pickers list Immich, and
            it immediately opens DocumentsUI at the Immich root, forwarding the result
            unchanged. One interface, one sort order, on every path.

            Registered for every MIME type, not just media. Narrow filters would make the
            app invisible to callers that ask for application/* or */* — the original
            reason Immich never appeared in document uploads. What the library can actually
            serve is decided per request, inside the picker.
        -->
        <activity
            android:name=".ui.SafPickerBridgeActivity"
            android:exported="true"
            android:label="@string/provider_root_title"
            android:theme="@style/Theme.ImmichPicker"
            android:excludeFromRecents="true"
            android:noHistory="true">

            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.OPEN_DOCUMENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
            The Storage Access Framework entry point.

            This provider does two jobs:

            1. Resolves the `content://` URIs the picker hands to the receiving app, so the
               original file streams over a normal read grant.
            2. Contributes one root to DocumentsUI, so the app is selectable in
               ACTION_OPEN_DOCUMENT dialogs — the "attach a file" path where DocumentsUI
               lists roots rather than activities and where the app was previously absent.

            Contract notes:

            - exported=true + permission=MANAGE_DOCUMENTS is required so that
              DocumentsUI (which holds MANAGE_DOCUMENTS) can bind to this provider.
            - grantUriPermissions=true lets DocumentsUI hand out per-URI grants to the
              receiving app, which is how the picked file is delivered with
              ACTION_OPEN_DOCUMENT / ACTION_GET_CONTENT.
            - targetApi=26 because openDocumentThumbnail()/the modern DocumentsProvider
              contract is only useful from O onwards; minSdk is 26 anyway.
        -->
        <provider
            android:name=".provider.ImmichDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS"
            android:enabled="true"
            android:settingsActivity="dev.immich.picker.ui.MainActivity">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

    </application>

</manifest>
