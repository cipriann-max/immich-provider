<?xml version="1.0" encoding="utf-8"?>
<!--
    Immich-style mark with a photo badge.

    The main glyph is the Immich camera-stack silhouette, drawn as a simple rounded
    frame so it stays legible at 48 dp. A distinct photo badge sits in the bottom-right
    corner: that is what makes the icon identifiable as "the one that gives you pictures"
    rather than just another copy of the Immich logo.

    Badge is positioned inside the 72 dp adaptive-icon safe zone so no launcher mask
    clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Main Immich frame -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30,34h44a8,8 0 0 1 8,8v28a8,8 0 0 1 -8,8H30a8,8 0 0 1 -8,-8V42a8,8 0 0 1 8,-8zM30,41v21l9.5,-11l7,8.5l6.5,-9l18,21V42H30z" />

    <!-- Aperture dot, keeps the mark recognisable as a camera -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,51m-4.5,0a4.5,4.5 0 1,0 9,0a4.5,4.5 0 1,0 -9,0" />

    <!-- Photo badge backing, punched out of the frame with the background colour -->
    <path
        android:fillColor="#1B7CE0"
        android:pathData="M64,64m-17,0a17,17 0 1,0 34,0a17,17 0 1,0 -34,0" />

    <!-- Photo badge: small framed landscape -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M55,56h18a2.5,2.5 0 0 1 2.5,2.5v11a2.5,2.5 0 0 1 -2.5,2.5H55a2.5,2.5 0 0 1 -2.5,-2.5v-11A2.5,2.5 0 0 1 55,56zM55,59.5v8.5l4.5,-5.5l3,3.5l3,-3.5l7,7.5V59.5H55z" />

    <!-- Badge sun -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M58,60.5m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0" />
</vector>
