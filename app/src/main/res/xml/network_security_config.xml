<?xml version="1.0" encoding="utf-8"?>
<!--
    Immich servers commonly run on a home network over plain HTTP or with a
    self-signed certificate. Cleartext is therefore permitted for all hosts, and
    user trust anchors are handled at runtime by TlsTrust in the OkHttp client.
    No system-level exceptions are declared because the app's own client decides
    whether to trust a given server.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
