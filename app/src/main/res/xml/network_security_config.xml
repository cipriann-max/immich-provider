<?xml version="1.0" encoding="utf-8"?>
<!--
    Immich servers commonly run on a home network over plain HTTP or with a
    self-signed certificate. Cleartext is therefore permitted for all hosts, and
    user trust anchors are included so a CA installed by the user on the device is
    honoured.

    Both choices are deliberate and cannot be tightened without breaking the
    self-hosted case this app exists for:

      - cleartextTrafficPermitted: a LAN Immich on http://host:2283 is the default
        deployment. Requiring HTTPS would exclude it entirely.
      - certificates src="user": the "Custom CA (PEM)" option in Settings feeds the
        app's own OkHttp client, but a user-installed CA is also needed for the
        platform trust store path.

    The stronger option — pinning or refusing user CAs in release — would make
    "Custom CA" unusable. See the Security notes in README.md.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors tools:ignore="AcceptsUserCertificates">
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
